{
  "name": "aletheia",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "aletheia": "dist/aletheia.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*/index.ts",
    "#shell/*": "./src/shell/*/index.ts"
  },
  "scripts": {
    "aletheia": "ALETHEIA_ENV=test node src/shell/cli/bin/bin.ts",
    "release": "node src/shell/release/bin/bin.ts",
    "check": "pnpm test && pnpm lint && pnpm format:check && pnpm typecheck && pnpm dead-code && pnpm duplication",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "dead-code": "knip",
    "duplication": "jscpd"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "26.6.5",
    "commander": "15.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rolldown": "1.2.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.28.8"
}
