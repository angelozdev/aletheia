    {
      "table": "card_status_history",
      "name": "card_status_history_status",
      "value": "\"status\" IN ('active','archived')",
      "entityType": "checks"
    },
    {
      "table": "card_status_history",
      "name": "card_status_history_reason",
      "value": "(\"status\" = 'archived' AND \"reason\" IS NOT NULL AND length(trim(\"reason\")) > 0) OR (\"status\" = 'active' AND \"reason\" IS NULL)",
      "entityType": "checks"
    },
    {
      "table": "card_tags",
      "name": "card_tags_tag",
      "value": "length(\"tag\") > 0 AND \"tag\" NOT GLOB '*[^a-z0-9:-]*'",
      "entityType": "checks"
    },
    {
      "table": "cards",
      "name": "cards_id",
      "value": "length(\"id\") = 4 AND \"id\" NOT GLOB '*[^0-9a-hjkmnp-tv-z]*'",
      "entityType": "checks"
    },
    {
      "table": "cards",
      "name": "cards_type",
      "value": "\"type\" IN ('concept','comparison','command','scenario','code')",
      "entityType": "checks"
    },
    {
      "table": "cards",
      "name": "cards_question",
      "value": "length(trim(\"question\")) > 0",
      "entityType": "checks"
    },
    {
      "table": "cards",
      "name": "cards_answer",
      "value": "length(trim(\"answer\")) > 0",
      "entityType": "checks"
    },
    {
      "table": "cards",
      "name": "cards_situation",
      "value": "length(trim(\"situation\")) > 0",
      "entityType": "checks"
    },
    {
      "table": "cards",
      "name": "cards_source",
      "value": "length(trim(\"source\")) > 0",
      "entityType": "checks"
    },
    {
      "table": "cards",
      "name": "cards_key_points",
      "value": "json_valid(\"key_points\") AND json_array_length(\"key_points\") BETWEEN 1 AND 3",
      "entityType": "checks"
    },
    {
      "table": "cards",
      "name": "cards_status",
      "value": "\"status\" IN ('active','archived')",
      "entityType": "checks"
    },
    {
      "table": "cards",
      "name": "cards_state",
      "value": "\"state\" IN ('new','learning','review','relearning')",
      "entityType": "checks"
    },
    {
      "table": "keeps",
      "name": "keeps_reason",
      "value": "\"reason\" IN ('leech','not-useful','outdated-situation','overlapping')",
      "entityType": "checks"
    },
    {
      "table": "keeps",
      "name": "keeps_overlaps",
      "value": "(\"reason\" = 'overlapping') = (\"overlaps\" IS NOT NULL)",
      "entityType": "checks"
    },
    {
      "table": "keeps",
      "name": "keeps_overlaps_other",
      "value": "\"overlaps\" IS NULL OR \"overlaps\" <> \"card_id\"",
      "entityType": "checks"
    },
    {
      "table": "reviews",
      "name": "reviews_grade",
      "value": "\"grade\" IN ('again','hard','good','easy')",
      "entityType": "checks"
    },
    {
      "table": "reviews",
      "name": "reviews_claude_grade",
      "value": "\"claude_grade\" IN ('again','hard','good','easy')",
      "entityType": "checks"
    },
    {
      "table": "reviews",
      "name": "reviews_state_before",
      "value": "\"state_before\" IN ('new','learning','review','relearning')",
      "entityType": "checks"
    },
    {
      "table": "reviews",
      "name": "reviews_answer",
      "value": "length(trim(\"answer\")) > 0",
      "entityType": "checks"
    },
    {
      "table": "reviews",
      "name": "reviews_rationale",
      "value": "length(trim(\"rationale\")) > 0",
      "entityType": "checks"
    },
    {
      "table": "reviews",
      "name": "reviews_flag",
      "value": "\"flag\" IS NULL OR \"flag\" IN ('missing-prerequisite','badly-written','badly-rephrased','not-useful')",
      "entityType": "checks"
    },
    {
      "table": "reviews",
      "name": "reviews_gap_is_again",
      "value": "\"flag\" IS NOT 'missing-prerequisite' OR \"grade\" = 'again'",
      "entityType": "checks"
    },
    {
      "table": "reviews",
      "name": "reviews_prerequisite_of",
      "value": "\"prerequisite_of\" IS NULL OR \"prerequisite_of\" <> \"card_id\"",
      "entityType": "checks"
    },
    {
      "table": "reviews",
      "name": "reviews_asked_question",
      "value": "\"asked_question\" IS NULL OR length(trim(\"asked_question\")) > 0",
      "entityType": "checks"
    },
    {
      "table": "settings",
      "name": "settings_single_row",
      "value": "\"id\" = 1",
      "entityType": "checks"
    },
    {
      "table": "settings",
      "name": "settings_session_size",
      "value": "\"session_size\" IS NULL OR \"session_size\" >= 1",
      "entityType": "checks"
    },
    {
      "table": "settings",
      "name": "settings_new_per_day",
      "value": "\"new_per_day\" IS NULL OR \"new_per_day\" >= 0",
      "entityType": "checks"
    },
    {
      "table": "settings",
      "name": "settings_new_share",
      "value": "\"new_share\" IS NULL OR \"new_share\" BETWEEN 0 AND 100",
      "entityType": "checks"
    },
    {
      "table": "settings",
      "name": "settings_leech_failures",
      "value": "\"leech_failures\" IS NULL OR \"leech_failures\" >= 1",
      "entityType": "checks"
    },
    {
      "table": "settings",
      "name": "settings_keep_months",
      "value": "\"keep_months\" IS NULL OR \"keep_months\" >= 1",
      "entityType": "checks"
    }
  ],
  "renames": []
}
